model PermissionsRoleRevision {
  tenantId  String   @id @db.NVarChar(64)
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("permissions_role_revisions")
}

model PermissionsRoleAssignment {
  id            String    @id @default(cuid()) @db.NVarChar(64)
  tenantId      String    @db.NVarChar(64)
  principalType String    @db.NVarChar(50)
  principalId   String    @db.NVarChar(64)
  roleId        String    @db.NVarChar(200)
  assigned      Boolean
  syncStatus    String    @default("pending") @db.NVarChar(50)
  syncError     String?   @db.NVarChar(500)
  syncedAt      DateTime?
  revision      Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, principalType, principalId, roleId])
  @@index([tenantId, assigned, syncStatus])
  @@map("permissions_role_assignments")
}

model PermissionsRoleCommand {
  id                 String   @id @default(cuid()) @db.NVarChar(64)
  tenantId           String   @db.NVarChar(64)
  idempotencyKey     String   @db.NVarChar(200)
  commandHash        String   @db.NVarChar(64)
  assignmentId       String   @db.NVarChar(64)
  consistencyVersion String   @db.NVarChar(50)
  changed            Boolean
  assigned           Boolean
  createdAt          DateTime @default(now())

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@map("permissions_role_commands")
}

