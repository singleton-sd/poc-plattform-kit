// Azure SQL + Prisma sqlserver
// Foundation schema: shared User stub + per-pillar Outbox + local Audit.
// Per AGENTS.md: no cross-pillar DB joins -- each pillar gets its own
// Outbox/Audit tables rather than a shared table with a pillar column, so
// there's nothing to join across pillars even by accident. Domain entities
// (Tenant, Contact, Subscription, ...) land via their own foundation tickets.

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Shared identity stub -- tenancy/roles land with the SingleSignOn ticket.
model User {
  id        String   @id @default(cuid())
  entraOid  String   @unique
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// --- Tenant ---

model TenantOutbox {
  id          String    @id @default(cuid())
  eventType   String
  payload     String
  occurredAt  DateTime  @default(now())
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("tenant_outbox")
}

model TenantAudit {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    String?
  changes    String
  createdAt  DateTime @default(now())

  @@map("tenant_audit")
}

// --- SingleSignOn ---

model SingleSignOnOutbox {
  id          String    @id @default(cuid())
  eventType   String
  payload     String
  occurredAt  DateTime  @default(now())
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("single_sign_on_outbox")
}

model SingleSignOnAudit {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    String?
  changes    String
  createdAt  DateTime @default(now())

  @@map("single_sign_on_audit")
}

