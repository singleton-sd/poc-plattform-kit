// --- Permissions ---

/// Access request workflow: requester asks for a denied action; tenant admin
/// or manager approves (permanent / temporary / one-time) or denies.
model AccessRequest {
  id                      String    @id @default(cuid()) @db.NVarChar(64)
  tenantId                String    @db.NVarChar(64)
  requesterId             String    @db.NVarChar(64)
  requesterEntraOid       String    @db.NVarChar(36)
  action                  String    @db.NVarChar(200)
  resource                String    @db.NVarChar(200)
  status                  String    @db.NVarChar(50)
  decidedById             String?   @db.NVarChar(64)
  decidedAt               DateTime?
  denyReason              String?   @db.NVarChar(500)
  grantType               String?   @db.NVarChar(50)
  /// When the pending request itself expires if still undecided.
  requestExpiresAt        DateTime?
  /// Absolute grant expiry when grantType is temporary (set on approve).
  grantExpiresAt          DateTime?
  /// Requester's preferred grant type (hint for approvers); set on create.
  preferredGrantType      String?   @db.NVarChar(50)
  /// Preferred temporary grant expiry when preferredGrantType is temporary.
  preferredGrantExpiresAt DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([requesterId, status])
  @@index([requesterId, action, resource, status])
  @@map("access_requests")
}

