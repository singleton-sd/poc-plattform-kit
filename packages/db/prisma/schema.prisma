// Azure SQL + Prisma sqlserver
// Foundation schema: shared User stub + per-pillar Outbox + local Audit.
// Per AGENTS.md: no cross-pillar DB joins -- each pillar gets its own
// Outbox/Audit tables rather than a shared table with a pillar column, so
// there's nothing to join across pillars even by accident. Domain entities
// (Tenant, Contact, Subscription, ...) land via their own foundation tickets.
//
// Identifier column lengths: docs/adr/0005-entity-id-strategy.md and
// docs/db-practices.md (EntityId = NVarChar(64), etc.).

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Shared identity stub -- tenancy/roles land with the SingleSignOn ticket.
model User {
  id        String   @id @default(cuid()) @db.NVarChar(64)
  entraOid  String   @unique @db.NVarChar(36)
  email     String   @unique @db.NVarChar(320)
  name      String?  @db.NVarChar(200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// --- Tenant ---

model Tenant {
  id        String   @id @default(cuid()) @db.NVarChar(64)
  name      String   @db.NVarChar(200)
  slug      String   @unique @db.NVarChar(100)
  settings  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenants")
}

/// Per-tenant membership + role (e.g. "owner"). Foundation for invitations
/// and future per-tenant roles; fine-grained authZ stays with the
/// Permissions pillar (OpenFGA) -- this table is identity/membership only.
model TenantMembership {
  id        String   @id @default(cuid()) @db.NVarChar(64)
  tenantId  String   @db.NVarChar(64)
  userId    String   @db.NVarChar(64)
  role      String   @db.NVarChar(50)
  createdAt DateTime @default(now())

  @@unique([tenantId, userId])
  @@map("tenant_memberships")
}

/// Tenant-local authorization principal. Groups deliberately do not mirror
/// Entra groups: their lifecycle and membership are owned by the tenant.
model TenantGroup {
  id          String   @id @default(cuid()) @db.NVarChar(64)
  tenantId    String   @db.NVarChar(64)
  name        String   @db.NVarChar(200)
  description String?  @db.NVarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, createdAt])
  @@map("tenant_groups")
}

/// Local source of truth for a user's membership of a tenant group.
/// `syncStatus` gates effective OpenFGA membership: pending/failed additions
/// are denied until reconciliation has written the tuple successfully.
model TenantGroupMembership {
  id          String    @id @default(cuid()) @db.NVarChar(64)
  tenantId    String    @db.NVarChar(64)
  groupId     String    @db.NVarChar(64)
  userId      String    @db.NVarChar(64)
  syncStatus  String    @default("pending") @db.NVarChar(50)
  syncError   String?   @db.NVarChar(500)
  syncedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([groupId, userId])
  @@index([tenantId, userId])
  @@index([syncStatus, updatedAt])
  @@map("tenant_group_memberships")
}

/// Pending invitation for someone to join a tenant by email. Accept/decline
/// handling lands in a follow-up ticket (86d3zetkn) and the send-the-email
/// step lives in a Notifications ticket (86d3zetkq); this model only backs
/// create/list/revoke. `token` is stored raw (not hashed) -- PoC-simple per
/// the ticket, single-use via `status` transitions out of "pending".
model TenantInvitation {
  id              String    @id @default(cuid()) @db.NVarChar(64)
  tenantId        String    @db.NVarChar(64)
  email           String    @db.NVarChar(320)
  role            String    @db.NVarChar(50)
  invitedByUserId String    @db.NVarChar(64)
  token           String    @unique @db.NVarChar(64)
  /// "pending" | "accepted" | "declined" | "revoked" | "expired"
  status          String    @default("pending") @db.NVarChar(50)
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  respondedAt     DateTime?

  // NOTE: the migration also hand-writes a filtered UNIQUE NONCLUSTERED
  // index on ([tenantId], [email]) WHERE [status] = 'pending'
  // (tenant_invitations_pending_email_key) to close a duplicate-invite race.
  // Prisma's schema DSL has no filtered-unique-index syntax, so it can't be
  // declared here -- see packages/db/prisma/migrations/20260809120000_add_tenant_invitations/migration.sql
  // and TenantInvitationService.create().
  @@index([tenantId, email])
  @@map("tenant_invitations")
}

model TenantOutbox {
  id            String    @id @default(cuid()) @db.NVarChar(64)
  eventType     String    @db.NVarChar(200)
  payload       String
  occurredAt    DateTime  @default(now())
  processedAt   DateTime?
  claimedAt     DateTime?
  claimId       String?   @db.NVarChar(64)
  failedAt      DateTime?
  failureReason String?   @db.NVarChar(500)
  createdAt     DateTime  @default(now())

  @@map("tenant_outbox")
}

model TenantAudit {
  id         String   @id @default(cuid()) @db.NVarChar(64)
  entityType String   @db.NVarChar(100)
  entityId   String   @db.NVarChar(64)
  action     String   @db.NVarChar(200)
  actorId    String?  @db.NVarChar(64)
  changes    String
  createdAt  DateTime @default(now())

  @@map("tenant_audit")
}

