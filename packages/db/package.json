{
  "name": "@poc-plattform-kit/db",
  "version": "0.2.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "lint": "echo \"lint:db stub\"",
    "test": "prisma validate && node --test scripts/*.test.mjs scripts/scenarios/*.test.mjs",
    "preview:schema": "node scripts/generate-preview-schema.mjs",
    "preview:generate": "prisma generate --schema=prisma/schema.preview.prisma",
    "preview:push": "prisma db push --schema=prisma/schema.preview.prisma --skip-generate --accept-data-loss",
    "preview:seed": "node scripts/seed.mjs",
    "preview:scenarios:list": "node scripts/seed.mjs --list"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.7.2"
  }
}
