{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Service is healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/health/db": {
      "get": {
        "operationId": "HealthController_checkDatabase",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The database is queryable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/changelog": {
      "get": {
        "operationId": "ChangelogController_getChangelog",
        "summary": "List recent client-facing API changes",
        "parameters": [],
        "responses": {
          "200": {
            "description": "All recorded API releases and their client-facing changes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangelogResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "Changelog"
        ]
      }
    },
    "/tenants": {
      "get": {
        "operationId": "TenantController_findAll",
        "parameters": [
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Substring to match against the tenant name or slug.",
            "schema": {
              "maxLength": 100,
              "example": "acme",
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Maximum tenants returned per page.",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "type": "number"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "Opaque pagination cursor from a previous response’s nextCursor. Omit to fetch the first page.",
            "schema": {
              "maxLength": 50,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of tenants matching the optional name or slug search.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantListResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid session/JWT."
          },
          "403": {
            "description": "Requires the support-agent role."
          }
        },
        "tags": [
          "tenants"
        ],
        "security": [
          {
            "oauth2": []
          },
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "operationId": "TenantController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTenantDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tenant created; the caller is auto-assigned as its owner.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid session/JWT."
          }
        },
        "tags": [
          "tenants"
        ],
        "security": [
          {
            "oauth2": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/tenants/{id}": {
      "get": {
        "operationId": "TenantController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-tenant-id",
            "in": "header",
            "description": "Legacy/dev tenancy escape when the token has no tenant_id claim. Claim wins when both are present.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tenant by id (requires matching tenancy context).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid session/JWT."
          }
        },
        "tags": [
          "tenants"
        ],
        "security": [
          {
            "oauth2": []
          },
          {
            "bearer": []
          }
        ]
      },
      "patch": {
        "operationId": "TenantController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-tenant-id",
            "in": "header",
            "description": "Legacy/dev tenancy escape when the token has no tenant_id claim. Claim wins when both are present.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTenantDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tenant updated after AuthN, tenancy, role, and Permissions AuthZ checks.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid session/JWT."
          },
          "403": {
            "description": "Requires tenant-admin role and Permissions tuple user:<id>, update, tenant:<id>."
          }
        },
        "tags": [
          "tenants"
        ],
        "security": [
          {
            "oauth2": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/me": {
      "get": {
        "operationId": "SingleSignOnController_me",
        "summary": "Current authenticated user (cookie session or Bearer JWT)",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Authenticated user profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "tags": [
          "SingleSignOn"
        ],
        "security": [
          {
            "oauth2": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/permissions/check": {
      "post": {
        "operationId": "PermissionsController_check",
        "summary": "Check a fine-grained authorization decision",
        "description": "Evaluates a subject, action, and resource tuple. Fails closed until OpenFGA is configured. One-time grants are revoked after the first successful allow.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckPermissionDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckPermissionResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid session/JWT."
          }
        },
        "tags": [
          "permissions"
        ],
        "security": [
          {
            "oauth2": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/permissions/grants": {
      "post": {
        "operationId": "PermissionsController_grant",
        "summary": "Grant a permission (permanent, temporary, or one-time)",
        "description": "Writes an OpenFGA relationship tuple. Temporary grants use condition not_yet_expired. One-time grants are consumed on the next successful Check. Trusted internal callers only — approver AuthZ is enforced by the Access Request workflow.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GrantPermissionDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GrantPermissionResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid session/JWT."
          }
        },
        "tags": [
          "permissions"
        ],
        "security": [
          {
            "oauth2": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/permissions/grants/revoke": {
      "post": {
        "operationId": "PermissionsController_revoke",
        "summary": "Revoke a previously granted permission",
        "description": "Deletes the OpenFGA relationship tuple (and any one-time marker). Trusted internal callers only.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevokePermissionDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevokePermissionResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid session/JWT."
          }
        },
        "tags": [
          "permissions"
        ],
        "security": [
          {
            "oauth2": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/permissions/health": {
      "get": {
        "operationId": "PermissionsController_health",
        "summary": "Report Permissions pillar health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PermissionsHealthResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "permissions"
        ],
        "security": [
          {
            "oauth2": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/permissions/access-requests": {
      "post": {
        "operationId": "AccessRequestController_create",
        "summary": "Create an access request for a denied action",
        "description": "Captures subject/action/resource for the current user. Idempotent for an existing non-expired pending request on the same action+resource. Publishes permission.access_requested (outbox) so Notifications can alert eligible approvers.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAccessRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessRequestResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed or tenant claim missing."
          },
          "401": {
            "description": "Missing or invalid session/JWT."
          },
          "403": {
            "description": "Body tenantId is not a tenant the caller belongs to."
          }
        },
        "tags": [
          "permissions"
        ],
        "security": [
          {
            "oauth2": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/permissions/access-requests/mine": {
      "get": {
        "operationId": "AccessRequestController_listMine",
        "summary": "List access requests filed by the current user",
        "description": "Optional action/resource filters. Newest first (max 50).",
        "parameters": [
          {
            "name": "action",
            "required": false,
            "in": "query",
            "schema": {
              "example": "update",
              "type": "string"
            }
          },
          {
            "name": "resource",
            "required": false,
            "in": "query",
            "schema": {
              "example": "tenant:acme",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessRequestListResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid session/JWT."
          }
        },
        "tags": [
          "permissions"
        ],
        "security": [
          {
            "oauth2": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/permissions/access-requests/pending": {
      "get": {
        "operationId": "AccessRequestController_listPending",
        "summary": "List pending access requests visible to the caller",
        "description": "Returns non-expired pending requests in the caller tenant where the caller is a tenant admin (OpenFGA) or the requester’s manager chain member. Does not mutate expired rows.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessRequestListResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Session has no tenant claim."
          },
          "401": {
            "description": "Missing or invalid session/JWT."
          }
        },
        "tags": [
          "permissions"
        ],
        "security": [
          {
            "oauth2": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/permissions/access-requests/{id}/approve": {
      "post": {
        "operationId": "AccessRequestController_approve",
        "summary": "Approve an access request and grant the permission",
        "description": "Caller must be a same-tenant eligible approver (not the requester). Claims the row, then calls Grant API; rolls back / revokes on failure.",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveAccessRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessRequestResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid grant payload or grant declined."
          },
          "401": {
            "description": "Missing or invalid session/JWT."
          },
          "403": {
            "description": "Not an eligible approver or self-approval."
          },
          "404": {
            "description": "Access request not found."
          },
          "409": {
            "description": "Concurrent decide already claimed the request."
          },
          "410": {
            "description": "Pending request expired."
          }
        },
        "tags": [
          "permissions"
        ],
        "security": [
          {
            "oauth2": []
          },
          {
            "bearer": []
          }
        ]
      }
    },
    "/permissions/access-requests/{id}/deny": {
      "post": {
        "operationId": "AccessRequestController_deny",
        "summary": "Deny an access request",
        "description": "Caller must be a same-tenant eligible approver (not the requester).",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DenyAccessRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessRequestResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Request is not pending."
          },
          "401": {
            "description": "Missing or invalid session/JWT."
          },
          "403": {
            "description": "Not an eligible approver or self-denial."
          },
          "404": {
            "description": "Access request not found."
          },
          "409": {
            "description": "Concurrent decide already claimed the request."
          },
          "410": {
            "description": "Pending request expired."
          }
        },
        "tags": [
          "permissions"
        ],
        "security": [
          {
            "oauth2": []
          },
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "info": {
    "title": "Platform Kit API",
    "description": "poc-plattform-kit API",
    "version": "0.22.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "x-tenant-id": {
        "type": "apiKey",
        "in": "header",
        "name": "x-tenant-id"
      },
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize",
            "tokenUrl": "/docs/oauth2/token",
            "scopes": {
              "openid": "Sign in",
              "profile": "User profile",
              "offline_access": "Refresh token",
              "platform-kit/.default": "Access Platform Kit API"
            }
          }
        },
        "description": "Microsoft Entra ID (authorization code + PKCE). Register Web redirect URI `/docs/oauth2-redirect.html` on the API app registration. Token exchange is proxied by this API."
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "ChangelogChangeDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "New"
          },
          "summary": {
            "type": "string",
            "example": "Add audit history"
          },
          "reason": {
            "type": "string",
            "example": "So administrators can explain account changes."
          }
        },
        "required": [
          "type",
          "summary"
        ]
      },
      "ChangelogReleaseDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "example": "0.22.0"
          },
          "date": {
            "type": "string",
            "example": "2026-08-08",
            "format": "date"
          },
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChangelogChangeDto"
            }
          }
        },
        "required": [
          "version",
          "date",
          "changes"
        ]
      },
      "ChangelogResponseDto": {
        "type": "object",
        "properties": {
          "product": {
            "type": "string",
            "example": "@poc-plattform-kit/api"
          },
          "releases": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChangelogReleaseDto"
            }
          }
        },
        "required": [
          "product",
          "releases"
        ]
      },
      "TenantResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          },
          "name": {
            "type": "string",
            "example": "Acme Corp"
          },
          "slug": {
            "type": "string",
            "example": "acme-corp"
          },
          "settings": {
            "type": "object",
            "additionalProperties": true,
            "nullable": true,
            "description": "Arbitrary tenant settings JSON object, or null."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "createdAt",
          "updatedAt"
        ]
      },
      "TenantListResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TenantResponseDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Cursor to pass as `cursor` to fetch the next page, or null when this is the last page.",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "CreateTenantDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Acme Corp"
          },
          "slug": {
            "type": "string",
            "example": "acme-corp",
            "description": "URL-friendly identifier. Generated from name when omitted or blank; format and uniqueness are validated when supplied."
          },
          "settings": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateTenantDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Acme Corporation"
          },
          "settings": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "oid-or-local-user-id"
          },
          "email": {
            "type": "string",
            "example": "agent@example.com"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "example": "Agent"
          },
          "roles": {
            "example": [
              "support-agent",
              "tenant-admin"
            ],
            "description": "Coarse Entra app roles from the access token / session.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "roles"
        ]
      },
      "CheckPermissionDto": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "example": "user:alice",
            "description": "OpenFGA subject identifier."
          },
          "action": {
            "type": "string",
            "example": "viewer",
            "description": "OpenFGA relation or permission."
          },
          "resource": {
            "type": "string",
            "example": "document:quarterly-report",
            "description": "OpenFGA resource identifier."
          }
        },
        "required": [
          "subject",
          "action",
          "resource"
        ]
      },
      "CheckPermissionResponseDto": {
        "type": "object",
        "properties": {
          "allowed": {
            "type": "boolean",
            "example": false,
