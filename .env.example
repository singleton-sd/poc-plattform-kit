# Azure / local env for poc-plattform-kit
# Copy to `.env` and fill values. Never commit `.env`.

# Azure context (no secrets)
AZURE_SUBSCRIPTION_ID=7b8343d7-969f-4b71-8864-b7925e7fae30
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=rg-poc-plattform-kit
AZURE_LOCATION=australiaeast
AZURE_KEY_VAULT_NAME=ssd-pocpk-kv-dev-ae
AZURE_KEY_VAULT_URI=https://ssd-pocpk-kv-dev-ae.vault.azure.net/
AZURE_APPCONFIGURATION_ENDPOINT=https://ssd-pocpk-appcs-dev-ae.azconfig.io

# Secrets: pull from Key Vault (never commit real values). Config: App Configuration + KV refs.
# Pipelines: OIDC → Azure → KV/App Config. Do not use GitHub Actions secrets for tokens/passwords.

# Azure SQL (Prisma sqlserver) — filled by infra/deploy.ps1
AZURE_SQL_SERVER=
AZURE_SQL_SERVER_FQDN=
AZURE_SQL_DATABASE=pocpk
AZURE_SQL_ADMIN_LOGIN=pocpkadmin
AZURE_SQL_ADMIN_PASSWORD=
DATABASE_URL=sqlserver://SERVER.database.windows.net:1433;database=pocpk;user=pocpkadmin;password=REPLACE;encrypt=true

# Nest API — App Service (public: api.plattform-kit.poc.singletonsd.com)
AZURE_APP_SERVICE_NAME=
AZURE_APP_SERVICE_URL=https://api.plattform-kit.poc.singletonsd.com
PORT=3001
# Pull from KV secret appinsights-connection-string (optional locally; skips OTel if empty)
APPLICATIONINSIGHTS_CONNECTION_STRING=
CORS_ORIGINS=https://app.plattform-kit.poc.singletonsd.com,https://plattform-kit.poc.singletonsd.com,https://kind-rock-0f409fe00*.azurestaticapps.net,https://purple-field-05048bf00*.azurestaticapps.net

# Permissions / OpenFGA (non-secret App Configuration values)
OPENFGA_API_URL=
OPENFGA_STORE_ID=
OPENFGA_AUTHORIZATION_MODEL_ID=
OPENFGA_AUDIENCE=api://ssd-pocpk-openfga

# API PR previews — Container Apps + ACR (deploy-aca-preview.ps1 / KV)
AZURE_ACR_NAME=ssdpocpkacrdevae
AZURE_ACR_LOGIN_SERVER=
AZURE_CONTAINER_APPS_ENV=ssd-pocpk-cae-dev-ae
# ACR admin password lives in Key Vault only (acr-admin-password) — never commit

# Next.js PWA — Static Web Apps (public: app.plattform-kit.poc.singletonsd.com)
AZURE_STATIC_WEB_APP_NAME=
AZURE_STATIC_WEB_APP_URL=https://app.plattform-kit.poc.singletonsd.com
NEXT_PUBLIC_API_BASE_URL=https://api.plattform-kit.poc.singletonsd.com
# SWA Free / PR preview MSAL (Bearer). Cookie auth stays on custom domains.
# Bake via GitHub Variables on preview-web / deploy-web builds (IDs only).
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=
NEXT_PUBLIC_AZURE_AD_TENANT_ID=
# Optional; prefer `api://{audience-host}/access_as_user` (exposed API scope).
# Defaults to `api://{NEXT_PUBLIC_AZURE_AD_CLIENT_ID}/.default` when unset.
# Nest AZURE_AD_API_AUDIENCE must match the Application ID URI (api://…).
NEXT_PUBLIC_AZURE_AD_API_SCOPE=

# Marketing — Static Web Apps (public: plattform-kit.poc.singletonsd.com)
AZURE_MARKETING_SWA_NAME=ssd-pocpk-mkt-dev-ae
AZURE_MARKETING_URL=https://plattform-kit.poc.singletonsd.com
# Astro build-time origin for Contact → marketing-edge Function (not Nest)
PUBLIC_MARKETING_API_BASE_URL=https://ssd-pocpk-decap-oauth-dev-ae.azurewebsites.net

# Marketing-edge Function / Forward Email (also set on Function App via Bicep + KV)
# KV secret name: forwardemail-api-key
FORWARDEMAIL_API_KEY=
FORWARDEMAIL_BASE_URL=https://api.forwardemail.net
CONTACT_INBOX_EMAIL=hello@singletonsd.com
CONTACT_FROM_EMAIL=noreply@plattform-kit.poc.singletonsd.com
# PoC in-memory limiter on Function (per instance); default 5 / 60s
CONTACT_RATE_LIMIT_PER_MIN=5
CONTACT_RATE_LIMIT_WINDOW_MS=60000

# Service Bus (topics = {pillar}.events)
AZURE_SERVICEBUS_NAMESPACE=
AZURE_SERVICEBUS_CONNECTION_STRING=

# API throttling (positive integers; production loads from App Configuration)
API_THROTTLE_LIMIT=100
API_THROTTLE_TTL_MS=60000

# Entra / Auth.js (Option B cross-subdomain cookies; local cache —
# production loads via App Config + KV refs; SWA stays Free)
AUTH_SECRET=
# Public API origin Auth.js uses for redirects (must match Entra redirect URI)
AUTH_URL=https://api.plattform-kit.poc.singletonsd.com
# Shared cookie Domain for app.* + api.* (leading dot). Empty = host-only (local).
AUTH_COOKIE_DOMAIN=.plattform-kit.poc.singletonsd.com
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
# Entra API app ID URI (JWT audience); defaults to AZURE_AD_CLIENT_ID if unset
AZURE_AD_API_AUDIENCE=
# Optional Swagger OAuth scope (App Config: app:azureAd:swaggerScope).
# Same-app Authorize needs bare GUID: {AZURE_AD_CLIENT_ID}/.default
# AZURE_AD_SWAGGER_SCOPE=be2e487d-9cea-4060-a600-dbb68434e128/.default
# Optional absolute Swagger OAuth2 redirect (defaults to {AUTH_URL}/docs/oauth2-redirect.html)
# SWAGGER_OAUTH2_REDIRECT_URL=https://api.plattform-kit.poc.singletonsd.com/docs/oauth2-redirect.html

# Permissions: manager/reporting-line resolution via Microsoft Graph (read-only)
# Optional; defaults are 5 (depth) and 300000ms / 5min (cache) when unset.
MANAGER_CHAIN_MAX_DEPTH=
MANAGER_CHAIN_CACHE_TTL_MS=

# Tenant: per-user cap on tenants ownable via POST /tenants/self-service.
# Optional; defaults to 1 when unset.
SELF_SERVICE_TENANT_LIMIT=
# Email / Notifications (Forward Email)
# Runtime token: FORWARD_EMAIL_TOKEN (never commit). KV name remains forwardemail-api-key.
FORWARD_EMAIL_TOKEN=
# Legacy alias still accepted by the client:
# FORWARDEMAIL_API_KEY=
FORWARD_EMAIL_BASE_URL=https://api.forwardemail.net
EMAIL_PROVIDER=development
EMAIL_FROM_ADDRESS=noreply@plattform-kit.poc.singletonsd.com
EMAIL_FROM_NAME=Plattform Kit
CONTACT_INBOX_ADDRESS=hello@singletonsd.com
# Production App Service / Functions must set EMAIL_PROVIDER=forward-email and:
# EMAIL_ALLOW_PRODUCTION_SEND=true
