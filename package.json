{
  "name": "poc-plattform-kit",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint && pnpm exec eslint .",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:web": "pnpm --filter @poc-plattform-kit/web dev",
    "dev:api": "pnpm --filter @poc-plattform-kit/api start:dev",
    "sync:skills": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-skills.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=20"
  }
}
