{
  "name": "poc-plattform-kit",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint && pnpm exec eslint .",
    "lint:staged": "lint-staged",
    "prepush": "node scripts/pre-push-checks.mjs",
    "test:prepush": "node --test scripts/pre-push-checks.test.mjs",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:web": "pnpm --filter @poc-plattform-kit/web dev",
    "dev:api": "pnpm --filter @poc-plattform-kit/api start:dev",
    "dev:marketing": "pnpm --filter @poc-plattform-kit/marketing dev",
    "validate:email-domain-branding": "pnpm --filter @poc-plattform-kit/email validate:domain-branding",
    "openapi:export": "pnpm --filter @poc-plattform-kit/api openapi:export",
    "openapi:generate": "pnpm --filter @poc-plattform-kit/api-client generate",
    "openapi:check": "pnpm openapi:export && pnpm openapi:generate && git diff --exit-code -- packages/api-client/openapi.json packages/api-client/src/generated || (echo \"OpenAPI client drift — run: pnpm openapi:export && pnpm openapi:generate\" && exit 1)",
    "stage:api-deploy": "bash ./scripts/stage-api-deploy.sh",
    "stage:api-deploy:docker": "bash ./scripts/stage-api-deploy-docker.sh",
    "skills:install": "node ./scripts/install-skills.mjs",
    "skills:install:pin": "node ./scripts/install-skills.mjs --pin",
    "sync:skills": "node ./scripts/install-skills.mjs --pin",
    "resolve:conflicts": "node ./scripts/invoke-ps1.mjs ./scripts/resolve-merge-conflicts.ps1",
    "release": "node ./scripts/release-changed.mjs",
    "release:ci": "node ./scripts/release-changed.mjs --ci",
    "changelog:check": "node ./scripts/check-client-changelogs.mjs",
    "permissions:check": "node ./scripts/check-permissions-catalog.mjs",
    "permissions:register": "node ./scripts/register-permission.mjs",
    "changelog:test": "node --test ./scripts/client-changelog.test.mjs ./scripts/backfill-client-changelogs.test.mjs ./scripts/check-client-changelogs.test.mjs",
    "changelog:backfill": "node ./scripts/backfill-client-changelogs.mjs",
    "changelog:backfill:dry-run": "node ./scripts/backfill-client-changelogs.mjs --dry-run",
    "prepare": "husky",
    "pr:gate": "node scripts/pr-handoff-gate.mjs",
    "test:pr-automation": "node scripts/pr-handoff-gate.test.mjs && node scripts/upsert-pr-review-brief.test.mjs && bash scripts/clickup-handoff.test.sh && bash scripts/recover-clickup-pr.test.sh && bash scripts/complete-clickup-on-merge.test.sh && node scripts/worktree-paths.test.mjs && node --test scripts/invoke-ps1.test.mjs && pnpm test:prepush",
    "bootstrap:worktree": "node ./scripts/invoke-bootstrap-worktree.mjs",
    "bootstrap:worktree:quick": "node ./scripts/invoke-bootstrap-worktree.mjs --quick-check",
    "worktree:add": "node ./scripts/invoke-worktree-add.mjs",
    "test:worktree-paths": "node scripts/worktree-paths.test.mjs"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{js,mjs,cjs,ts,tsx}": "eslint --fix --max-warnings=0 --no-warn-ignored"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@release-it/conventional-changelog": "^10.0.0",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.5.3",
    "release-it": "^18.0.0",
    "semver": "^7.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
