{
  "name": "poc-plattform-kit",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint && pnpm exec eslint .",
    "lint:staged": "lint-staged",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:web": "pnpm --filter @poc-plattform-kit/web dev",
    "dev:api": "pnpm --filter @poc-plattform-kit/api start:dev",
    "dev:marketing": "pnpm --filter @poc-plattform-kit/marketing dev",
    "openapi:export": "pnpm --filter @poc-plattform-kit/api openapi:export",
    "openapi:generate": "pnpm --filter @poc-plattform-kit/api-client generate",
    "openapi:check": "pnpm openapi:export && pnpm openapi:generate && git diff --exit-code -- packages/api-client/openapi.json packages/api-client/src/generated || (echo \"OpenAPI client drift â€” run: pnpm openapi:export && pnpm openapi:generate\" && exit 1)",
    "stage:api-deploy": "bash ./scripts/stage-api-deploy.sh",
    "stage:api-deploy:docker": "bash ./scripts/stage-api-deploy-docker.sh",
    "sync:skills": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-skills.ps1",
    "resolve:conflicts": "powershell -ExecutionPolicy Bypass -File ./scripts/resolve-merge-conflicts.ps1",
    "bootstrap:worktree": "powershell -ExecutionPolicy Bypass -File ./scripts/bootstrap-worktree.ps1",
    "bootstrap:worktree:quick": "powershell -ExecutionPolicy Bypass -File ./scripts/bootstrap-worktree.ps1 -QuickCheck",
    "release": "node ./scripts/release-changed.mjs",
    "release:ci": "node ./scripts/release-changed.mjs --ci",
    "changelog:check": "node ./scripts/check-client-changelogs.mjs",
    "permissions:check": "node ./scripts/check-permissions-catalog.mjs",
    "permissions:register": "node ./scripts/register-permission.mjs",
    "changelog:test": "node --test ./scripts/client-changelog.test.mjs ./scripts/backfill-client-changelogs.test.mjs ./scripts/check-client-changelogs.test.mjs",
    "changelog:backfill": "node ./scripts/backfill-client-changelogs.mjs",
    "changelog:backfill:dry-run": "node ./scripts/backfill-client-changelogs.mjs --dry-run",
    "prepare": "husky",
    "pr:gate": "node scripts/pr-handoff-gate.mjs",
    "test:pr-automation": "node scripts/pr-handoff-gate.test.mjs && bash scripts/clickup-handoff.test.sh && bash scripts/recover-clickup-pr.test.sh && bash scripts/complete-clickup-on-merge.test.sh"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{js,mjs,cjs,ts,tsx}": "eslint --fix --max-warnings=0 --no-warn-ignored"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@release-it/conventional-changelog": "^10.0.0",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.5.3",
    "release-it": "^18.0.0",
    "semver": "^7.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
