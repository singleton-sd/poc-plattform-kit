{
  "$schema": "./custom-domains.schema.json",
  "comment": "poc-plattform-kit custom domains under singletonsd.com. Marketing CNAME targets GitHub Pages after the Pages cutover (docs/dns-route53.md). API CNAME targets production ACA after #303 cutover. Do not apply the marketing CNAME until Pages custom domain + TLS are configured — DNS is owned by the infrastructure owner.",
  "zoneDomain": "singletonsd.com",
  "resourceGroup": "rg-poc-plattform-kit",
  "ttlSeconds": 300,
  "records": [
    {
      "name": "plattform-kit.poc",
      "type": "CNAME",
      "value": "singleton-sd.github.io"
    },
    {
      "name": "app.plattform-kit.poc",
      "type": "CNAME",
      "value": "kind-rock-0f409fe00.7.azurestaticapps.net"
    },
    {
      "name": "api.plattform-kit.poc",
      "type": "CNAME",
      "value": "ssd-pocpk-aca-api-dev-ae.victoriouscliff-509c369b.australiaeast.azurecontainerapps.io"
    },
    {
      "name": "asuid.api.plattform-kit.poc",
      "type": "TXT",
      "value": "57B0B845C0477561D54FB97248C6B216A009F60CD996BC5613C024A2EE4E58F9"
    }
  ],
  "bindings": [
    {
      "kind": "swa",
      "resourceName": "pocpk-web-si5fhs6dvxiha",
      "hostname": "app.plattform-kit.poc.singletonsd.com"
    },
    {
      "kind": "containerapp",
      "resourceName": "ssd-pocpk-aca-api-dev-ae",
      "hostname": "api.plattform-kit.poc.singletonsd.com",
      "managedCert": true
    }
  ]
}
