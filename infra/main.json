{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.45.15.27210",
      "templateHash": "14201269547046170822"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for most resources"
      }
    },
    "swaLocation": {
      "type": "string",
      "defaultValue": "eastasia",
      "metadata": {
        "description": "Static Web Apps region (Free SKU is region-limited; eastasia works for AU PoCs)"
      }
    },
    "namePrefix": {
      "type": "string",
      "defaultValue": "pocpk",
      "minLength": 3,
      "maxLength": 20,
      "metadata": {
        "description": "Short name prefix for resources (lowercase alphanumeric)"
      }
    },
    "sqlAdminLogin": {
      "type": "string",
      "defaultValue": "pocpkadmin",
      "metadata": {
        "description": "SQL Server administrator login"
      }
    },
    "sqlAdminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "SQL Server administrator password (generated locally; never commit)"
      }
    },
    "appServiceSku": {
      "type": "string",
      "defaultValue": "B1",
      "allowedValues": [
        "B1",
        "B2",
        "S1"
      ],
      "metadata": {
        "description": "App Service Plan SKU"
      }
    },
    "staticWebAppSku": {
      "type": "string",
      "defaultValue": "Free",
      "allowedValues": [
        "Free",
        "Standard"
      ],
      "metadata": {
        "description": "Static Web Apps SKU"
      }
    },
    "serviceBusSku": {
      "type": "string",
      "defaultValue": "Standard",
      "allowedValues": [
        "Standard",
        "Premium"
      ],
      "metadata": {
        "description": "Service Bus SKU (Standard required for topics)"
      }
    },
    "sqlDatabaseName": {
      "type": "string",
      "defaultValue": "pocpk",
      "metadata": {
        "description": "Azure SQL database name"
      }
    }
  },
  "variables": {
    "uniqueSuffix": "[uniqueString(resourceGroup().id)]",
    "sqlServerName": "[format('{0}-sql-{1}', parameters('namePrefix'), variables('uniqueSuffix'))]",
    "appPlanName": "[format('{0}-plan', parameters('namePrefix'))]",
    "webAppName": "[format('{0}-api-{1}', parameters('namePrefix'), variables('uniqueSuffix'))]",
    "swaName": "[format('{0}-web-{1}', parameters('namePrefix'), variables('uniqueSuffix'))]",
    "serviceBusName": "[format('{0}-sb-{1}', parameters('namePrefix'), variables('uniqueSuffix'))]",
    "eventTopics": [
      "tenant.events",
      "single-sign-on.events",
      "subscriptions.events",
      "contact.events",
      "support.events",
      "audit.events",
      "reporting.events"
    ]
  },
  "resources": [
    {
      "type": "Microsoft.Sql/servers",
      "apiVersion": "2023-08-01-preview",
      "name": "[variables('sqlServerName')]",
      "location": "[parameters('location')]",
      "properties": {
        "administratorLogin": "[parameters('sqlAdminLogin')]",
        "administratorLoginPassword": "[parameters('sqlAdminPassword')]",
        "version": "12.0",
        "minimalTlsVersion": "1.2",
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.Sql/servers/firewallRules",
      "apiVersion": "2023-08-01-preview",
      "name": "[format('{0}/{1}', variables('sqlServerName'), 'AllowAzureServices')]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ]
    },
    {
      "type": "Microsoft.Sql/servers/firewallRules",
      "apiVersion": "2023-08-01-preview",
      "name": "[format('{0}/{1}', variables('sqlServerName'), 'AllowAllDevPoC')]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "255.255.255.255"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ]
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2023-08-01-preview",
      "name": "[format('{0}/{1}', variables('sqlServerName'), parameters('sqlDatabaseName'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Basic",
        "tier": "Basic",
        "capacity": 5
      },
      "properties": {
        "collation": "SQL_Latin1_General_CP1_CI_AS",
        "maxSizeBytes": 2147483648
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[variables('appPlanName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('appServiceSku')]"
      },
      "kind": "linux",
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[variables('webAppName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('appPlanName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "NODE|20-lts",
          "alwaysOn": false,
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "appSettings": [
            {
              "name": "WEBSITE_NODE_DEFAULT_VERSION",
              "value": "~20"
            },
            {
              "name": "SCM_DO_BUILD_DURING_DEPLOYMENT",
              "value": "true"
            },
            {
              "name": "AZURE_SERVICEBUS_NAMESPACE",
              "value": "[variables('serviceBusName')]"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('appPlanName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/staticSites",
      "apiVersion": "2022-09-01",
      "name": "[variables('swaName')]",
      "location": "[parameters('swaLocation')]",
      "sku": {
        "name": "[parameters('staticWebAppSku')]",
        "tier": "[parameters('staticWebAppSku')]"
      },
      "properties": {
        "allowConfigFileUpdates": true,
        "stagingEnvironmentPolicy": "Enabled"
      }
    },
    {
      "type": "Microsoft.ServiceBus/namespaces",
      "apiVersion": "2022-10-01-preview",
      "name": "[variables('serviceBusName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('serviceBusSku')]",
        "tier": "[parameters('serviceBusSku')]"
      },
      "properties": {
        "minimumTlsVersion": "1.2",
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "copy": {
        "name": "topics",
        "count": "[length(variables('eventTopics'))]"
      },
      "type": "Microsoft.ServiceBus/namespaces/topics",
      "apiVersion": "2022-10-01-preview",
      "name": "[format('{0}/{1}', variables('serviceBusName'), variables('eventTopics')[copyIndex()])]",
      "properties": {
        "defaultMessageTimeToLive": "P14D",
        "enableBatchedOperations": true,
        "supportOrdering": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.ServiceBus/namespaces', variables('serviceBusName'))]"
      ]
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "servicebus-subscriptions",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "serviceBusNamespaceName": {
            "value": "[variables('serviceBusName')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.45.15.27210",
              "templateHash": "9845290760102456163"
            }
          },
          "parameters": {
            "serviceBusNamespaceName": {
              "type": "string",
              "metadata": {
                "description": "Existing Service Bus namespace name"
              }
            }
          },
          "variables": {
            "consumers": [
              "audit",
              "reporting",
              "support"
            ]
          },
          "resources": [
            {
              "copy": {
                "name": "tenantSubs",
                "count": "[length(variables('consumers'))]"
              },
              "type": "Microsoft.ServiceBus/namespaces/topics/subscriptions",
              "apiVersion": "2022-10-01-preview",
              "name": "[format('{0}/{1}/{2}', parameters('serviceBusNamespaceName'), 'tenant.events', variables('consumers')[copyIndex()])]",
              "properties": {
                "deadLetteringOnMessageExpiration": true,
                "maxDeliveryCount": 10,
                "lockDuration": "PT1M"
              }
            },
            {
              "copy": {
                "name": "ssoSubs",
                "count": "[length(variables('consumers'))]"
              },
              "type": "Microsoft.ServiceBus/namespaces/topics/subscriptions",
              "apiVersion": "2022-10-01-preview",
              "name": "[format('{0}/{1}/{2}', parameters('serviceBusNamespaceName'), 'single-sign-on.events', variables('consumers')[copyIndex()])]",
              "properties": {
                "deadLetteringOnMessageExpiration": true,
                "maxDeliveryCount": 10,
                "lockDuration": "PT1M"
              }
            },
            {
              "copy": {
                "name": "subscriptionsSubs",
                "count": "[length(variables('consumers'))]"
              },
              "type": "Microsoft.ServiceBus/namespaces/topics/subscriptions",
              "apiVersion": "2022-10-01-preview",
              "name": "[format('{0}/{1}/{2}', parameters('serviceBusNamespaceName'), 'subscriptions.events', variables('consumers')[copyIndex()])]",
              "properties": {
                "deadLetteringOnMessageExpiration": true,
                "maxDeliveryCount": 10,
                "lockDuration": "PT1M"
              }
            },
            {
              "copy": {
                "name": "contactSubs",
                "count": "[length(variables('consumers'))]"
              },
              "type": "Microsoft.ServiceBus/namespaces/topics/subscriptions",
              "apiVersion": "2022-10-01-preview",
              "name": "[format('{0}/{1}/{2}', parameters('serviceBusNamespaceName'), 'contact.events', variables('consumers')[copyIndex()])]",
              "properties": {
                "deadLetteringOnMessageExpiration": true,
                "maxDeliveryCount": 10,
                "lockDuration": "PT1M"
              }
            }
          ],
          "outputs": {
            "createdSubscriptionCount": {
              "type": "int",
              "value": "[mul(length(variables('consumers')), 4)]"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ServiceBus/namespaces', variables('serviceBusName'))]",
        "topics"
      ]
    }
  ],
  "outputs": {
    "resourceGroupName": {
      "type": "string",
      "value": "[resourceGroup().name]"
    },
    "location": {
      "type": "string",
      "value": "[parameters('location')]"
    },
    "swaLocation": {
      "type": "string",
      "value": "[parameters('swaLocation')]"
    },
    "sqlServerName": {
      "type": "string",
      "value": "[variables('sqlServerName')]"
    },
    "sqlServerFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Sql/servers', variables('sqlServerName')), '2023-08-01-preview').fullyQualifiedDomainName]"
    },
    "sqlDatabaseName": {
      "type": "string",
      "value": "[parameters('sqlDatabaseName')]"
    },
    "sqlAdminLogin": {
      "type": "string",
      "value": "[parameters('sqlAdminLogin')]"
    },
    "webAppName": {
      "type": "string",
      "value": "[variables('webAppName')]"
    },
    "webAppHostname": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', variables('webAppName')), '2023-12-01').defaultHostName]"
    },
    "webAppPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', variables('webAppName')), '2023-12-01', 'full').identity.principalId]"
    },
    "staticWebAppName": {
      "type": "string",
      "value": "[variables('swaName')]"
    },
    "staticWebAppHostname": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/staticSites', variables('swaName')), '2022-09-01').defaultHostname]"
    },
    "serviceBusNamespaceName": {
      "type": "string",
      "value": "[variables('serviceBusName')]"
    },
    "serviceBusTopics": {
      "type": "array",
      "value": "[variables('eventTopics')]"
    },
    "appServicePlanName": {
      "type": "string",
      "value": "[variables('appPlanName')]"
    },
    "subscriptionModuleName": {
      "type": "string",
      "value": "servicebus-subscriptions"
    }
  }
}