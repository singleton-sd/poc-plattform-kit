{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "9206496046528424941"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region"
      }
    },
    "containerAppsEnvironmentName": {
      "type": "string",
      "defaultValue": "ssd-pocpk-cae-dev-ae",
      "metadata": {
        "description": "Existing Container Apps Environment name"
      }
    },
    "containerAppName": {
      "type": "string",
      "defaultValue": "ssd-pocpk-aca-api-dev-ae",
      "metadata": {
        "description": "Production Container App name (CAF)"
      }
    },
    "acrName": {
      "type": "string",
      "defaultValue": "ssdpocpkacrdevae",
      "metadata": {
        "description": "Existing ACR name (alphanumeric only)"
      }
    },
    "keyVaultName": {
      "type": "string",
      "defaultValue": "ssd-pocpk-kv-dev-ae",
      "metadata": {
        "description": "CAF Key Vault name"
      }
    },
    "appConfigName": {
      "type": "string",
      "defaultValue": "ssd-pocpk-appcs-dev-ae",
      "metadata": {
        "description": "CAF App Configuration store name"
      }
    },
    "applicationInsightsName": {
      "type": "string",
      "defaultValue": "ssd-pocpk-appi-dev-ae",
      "metadata": {
        "description": "CAF Application Insights name"
      }
    },
    "serviceBusNamespaceName": {
      "type": "string",
      "defaultValue": "pocpk-sb-si5fhs6dvxiha",
      "metadata": {
        "description": "Legacy Service Bus namespace name (AZURE_SERVICEBUS_NAMESPACE)"
      }
    },
    "apiImage": {
      "type": "string",
      "metadata": {
        "description": "Full container image reference (registry/repo:tag). Prefer commit SHA tags, not latest-only."
      }
    },
    "targetPort": {
      "type": "int",
      "defaultValue": 3001,
      "metadata": {
        "description": "Nest listen / ingress target port"
      }
    },
    "minReplicas": {
      "type": "int",
      "defaultValue": 0,
      "minValue": 0,
      "maxValue": 2,
      "metadata": {
        "description": "Minimum replicas — keep 0 for scale-to-zero PoC cost; 1 = always-on compute"
      }
    },
    "maxReplicas": {
      "type": "int",
      "defaultValue": 2,
      "minValue": 1,
      "maxValue": 5,
      "metadata": {
        "description": "Maximum replicas"
      }
    },
    "acrAdminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "ACR admin password (from Key Vault acr-admin-password; never commit)"
      }
    }
  },
  "variables": {
    "tags": {
      "project": "poc-plattform-kit",
      "environment": "dev",
      "purpose": "api-production"
    },
    "roleKeyVaultSecretsUser": "4633458b-17de-408a-b874-0445c86b69e6",
    "roleAppConfigDataReader": "516239f1-63e1-4d78-a4de-a74fb236a071"
  },
  "resources": [
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2025-01-01",
      "name": "[parameters('containerAppName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppsEnvironmentName'))]",
        "workloadProfileName": "Consumption",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": "[parameters('targetPort')]",
            "allowInsecure": false,
            "transport": "auto"
          },
          "secrets": [
            {
              "name": "acr-password",
              "value": "[parameters('acrAdminPassword')]"
            }
          ],
          "registries": [
            {
              "server": "[reference(resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName')), '2025-04-01').loginServer]",
              "username": "[listCredentials(resourceId('Microsoft.ContainerRegistry/registries', parameters('acrName')), '2025-04-01').username]",
              "passwordSecretRef": "acr-password"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "api",
              "image": "[parameters('apiImage')]",
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              },
              "env": [
                {
                  "name": "PORT",
                  "value": "[string(parameters('targetPort'))]"
                },
                {
                  "name": "NODE_ENV",
                  "value": "production"
                },
                {
                  "name": "AZURE_APPCONFIGURATION_ENDPOINT",
                  "value": "[reference(resourceId('Microsoft.AppConfiguration/configurationStores', parameters('appConfigName')), '2024-05-01').endpoint]"
                },
                {
                  "name": "AZURE_SERVICEBUS_NAMESPACE",
                  "value": "[parameters('serviceBusNamespaceName')]"
                },
                {
                  "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                  "value": "[reference(resourceId('Microsoft.Insights/components', parameters('applicationInsightsName')), '2020-02-02').ConnectionString]"
                },
                {
                  "name": "CORS_ORIGINS",
                  "value": "https://app.plattform-kit.poc.singletonsd.com,https://plattform-kit.poc.singletonsd.com,https://kind-rock-0f409fe00*.azurestaticapps.net,https://purple-field-05048bf00*.azurestaticapps.net"
                },
                {
                  "name": "NEXT_PUBLIC_API_BASE_URL",
                  "value": "https://api.plattform-kit.poc.singletonsd.com"
                }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/health",
                    "port": "[parameters('targetPort')]"
                  },
                  "initialDelaySeconds": 15,
                  "periodSeconds": 30
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/health",
                    "port": "[parameters('targetPort')]"
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": "[parameters('maxReplicas')]"
          }
        }
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), resourceId('Microsoft.App/containerApps', parameters('containerAppName')), variables('roleKeyVaultSecretsUser'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roleKeyVaultSecretsUser'))]",
        "principalId": "[reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2025-01-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/containerApps', parameters('containerAppName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.AppConfiguration/configurationStores', parameters('appConfigName'))]",
      "name": "[guid(resourceId('Microsoft.AppConfiguration/configurationStores', parameters('appConfigName')), resourceId('Microsoft.App/containerApps', parameters('containerAppName')), variables('roleAppConfigDataReader'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roleAppConfigDataReader'))]",
        "principalId": "[reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2025-01-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/containerApps', parameters('containerAppName'))]"
      ]
    }
  ],
  "outputs": {
    "containerAppName": {
      "type": "string",
      "value": "[parameters('containerAppName')]"
    },
    "containerAppFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2025-01-01').configuration.ingress.fqdn]"
    },
    "containerAppPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2025-01-01', 'full').identity.principalId]"
    },
    "containerAppUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2025-01-01').configuration.ingress.fqdn)]"
    },
    "minReplicas": {
      "type": "int",
      "value": "[parameters('minReplicas')]"
    },
    "maxReplicas": {
      "type": "int",
      "value": "[parameters('maxReplicas')]"
    }
  }
}