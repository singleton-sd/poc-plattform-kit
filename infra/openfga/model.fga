# Tenant-scoped authorization model for poc-plattform-kit (Permissions / OpenFGA).
# Source of truth for infra/deploy-openfga.ps1 (pushed as authorization model).
# Actions on type tenant match PermissionsService Check() relation names
# (create / update / delete / read) used by Nest route mappings.
#
# Temporary grants use condition not_yet_expired (tuple context expiry_time;
# Check supplies current_time). One-time grants write a companion marker on
# type one_time_grant; PermissionsService deletes the action tuple after the
# first successful Check.
#
# Manager chain: write direct tuples on `manager`; Check transitive via
# `in_manager_chain`. OpenFGA requires tupleset relations to be direct-only,
# so recursive `manager: [user] or manager from manager` is invalid.

model
  schema 1.1

type user
  relations
    # Direct Entra manager edge (user:A manager user:B).
    define manager: [user]
    # Transitive reporting line (A manages B manages C => A in_manager_chain of C).
    define in_manager_chain: manager or in_manager_chain from manager

type tenant
  relations
    define admin: [user, user with not_yet_expired]
    define member: [user, user with not_yet_expired] or admin
    define create: [user, user with not_yet_expired] or admin
    define update: [user, user with not_yet_expired] or admin
    define delete: [user, user with not_yet_expired] or admin
    define read: [user, user with not_yet_expired] or member

# Marker objects: one_time_grant:{resource}|{action} → pending: [user]
type one_time_grant
  relations
    define pending: [user]

condition not_yet_expired(current_time: timestamp, expiry_time: timestamp) {
  current_time < expiry_time
}
