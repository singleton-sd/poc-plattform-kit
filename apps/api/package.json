{
  "name": "@poc-plattform-kit/api",
  "version": "0.8.0",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "start:dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build",
    "lint": "echo \"lint:api stub\"",
    "test": "jest",
    "openapi:export": "pnpm --filter @poc-plattform-kit/db build && pnpm --filter @poc-plattform-kit/pillar-tenant build && pnpm --filter @poc-plattform-kit/pillar-single-sign-on build && pnpm --filter @poc-plattform-kit/pillar-permissions build && ts-node --transpile-only scripts/export-openapi.ts",
    "prebuild": "pnpm --filter @poc-plattform-kit/db build && pnpm --filter @poc-plattform-kit/pillar-tenant build && pnpm --filter @poc-plattform-kit/pillar-single-sign-on build && pnpm --filter @poc-plattform-kit/pillar-permissions build"
  },
  "dependencies": {
    "@auth/express": "^0.10.0",
    "@azure/app-configuration": "^1.12.1",
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@azure/monitor-opentelemetry": "^1.8.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@poc-plattform-kit/db": "workspace:*",
    "@poc-plattform-kit/pillar-permissions": "workspace:*",
    "@poc-plattform-kit/pillar-single-sign-on": "workspace:*",
    "@poc-plattform-kit/pillar-tenant": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jwks-rsa": "^3.1.0",
    "nestjs-pino": "^4.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.9",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@poc-plattform-kit/pillar-single-sign-on$": "<rootDir>/../../../pillars/single-sign-on/src/index.ts",
      "^@poc-plattform-kit/pillar-permissions$": "<rootDir>/../../../pillars/permissions/src/index.ts",
      "^@poc-plattform-kit/pillar-tenant$": "<rootDir>/../../../pillars/tenant/src/index.ts",
      "^@poc-plattform-kit/db$": "<rootDir>/../../../packages/db/src/index.ts"
    }
  }
}
