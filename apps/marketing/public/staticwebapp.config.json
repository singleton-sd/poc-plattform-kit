{
  "routes": [
    {
      "route": "/privacy",
      "rewrite": "/privacy.html"
    },
    {
      "route": "/terms",
      "rewrite": "/terms.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/privacy*", "/terms*", "/assets/*", "/*.{css,js,ico,png,svg,webmanifest}"]
  }
}
