{
  "routes": [
    {
      "route": "/admin",
      "redirect": "/admin/",
      "statusCode": 301
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/admin*",
      "/privacy*",
      "/terms*",
      "/assets/*",
      "/_astro/*",
      "/*.{css,js,ico,png,svg,webmanifest,yml,yaml}"
    ]
  }
}
