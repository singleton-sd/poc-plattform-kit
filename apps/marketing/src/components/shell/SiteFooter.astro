---
import Icon from '../ui/Icon.astro';
import { footerColumns } from '../../lib/nav';

interface Props {
  brand?: string;
  blurb?: string;
}

const {
  brand = 'Platform Kit',
  blurb = 'High-performance multi-tenant architecture designed for modern software groups.',
} = Astro.props;

const year = new Date().getFullYear();
---

<footer class="bg-bg-inverse text-fg-inverse">
  <div class="mx-auto max-w-content px-5 py-12 md:px-10 md:py-16">
    <div class="flex flex-col gap-12 lg:flex-row lg:justify-between">
      <div class="max-w-xs space-y-4">
        <div class="flex items-center gap-2">
          <span class="text-body-sm font-bold text-accent">{brand}</span>
          <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        </div>
        <p class="m-0 text-caption text-fg-subtle">{blurb}</p>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-4 sm:gap-16">
        {
          footerColumns.map((column) => (
            <div class="space-y-4">
              <p class="m-0 text-caption font-bold uppercase tracking-wide text-fg-inverse">
                {column.title}
              </p>
              <ul class="m-0 flex list-none flex-col gap-3 p-0">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-caption text-fg-subtle no-underline transition hover:text-accent"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-border-strong/40 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="m-0 text-caption text-fg-subtle">
        © {year} Singleton Software Development. All rights reserved.
      </p>
      <div class="flex items-center gap-4">
        <a
          href="https://github.com/singleton-sd/poc-plattform-kit"
          class="text-fg-subtle transition hover:text-accent"
          aria-label="GitHub"
        >
          <Icon name="github" size={20} />
        </a>
        <a href="https://twitter.com" class="text-fg-subtle transition hover:text-accent" aria-label="Twitter">
          <Icon name="twitter" size={20} />
        </a>
      </div>
    </div>
  </div>
</footer>
