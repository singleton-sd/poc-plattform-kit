---
import Icon from './Icon.astro';

interface Option {
  value: string;
  label: string;
}

interface Props {
  id: string;
  name?: string;
  label: string;
  options: Option[];
  value?: string;
  placeholder?: string;
  helper?: string;
  error?: string;
  required?: boolean;
  class?: string;
}

const {
  id,
  name = id,
  label,
  options,
  value,
  placeholder,
  helper,
  error,
  required = false,
  class: className = '',
} = Astro.props;

const describedBy = error ? `${id}-error` : helper ? `${id}-helper` : undefined;
---

<div class:list={['flex w-full flex-col gap-2', className]}>
  <label for={id} class="text-body-sm font-semibold text-fg">
    {label}
    {
      required ? (
        <span class="text-accent" aria-hidden="true">
          {' '}
          *
        </span>
      ) : null
    }
  </label>
  <div class="relative">
    <select
      id={id}
      name={name}
      required={required}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={describedBy}
      class:list={[
        'w-full appearance-none rounded-md border bg-bg px-3 py-3 pr-10 text-body-sm text-fg outline-none transition',
        'focus:border-2 focus:border-accent',
        error ? 'border-status-error' : 'border-border',
      ]}
    >
      {
        placeholder ? (
          <option value="" disabled selected={!value}>
            {placeholder}
          </option>
        ) : null
      }
      {
        options.map((option) => (
          <option value={option.value} selected={option.value === value}>
            {option.label}
          </option>
        ))
      }
    </select>
    <Icon
      name="chevron-down"
      size={16}
      class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-fg-muted"
    />
  </div>
  {
    error ? (
      <p id={`${id}-error`} class="m-0 text-caption text-status-error">
        {error}
      </p>
    ) : helper ? (
      <p id={`${id}-helper`} class="m-0 text-caption text-fg-muted">
        {helper}
      </p>
    ) : null
  }
</div>
