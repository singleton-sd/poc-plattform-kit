---
import type { IconName } from '../../lib/icons';

interface Props {
  name: IconName;
  class?: string;
  size?: number;
  label?: string;
}

const { name, class: className = '', size = 24, label } = Astro.props;
const ariaHidden = label ? undefined : true;
const role = label ? 'img' : undefined;

const paths: Record<IconName, string> = {
  menu: '<line x1="4" y1="6" x2="20" y2="6" /><line x1="4" y1="12" x2="20" y2="12" /><line x1="4" y1="18" x2="20" y2="18" />',
  close:
    '<circle cx="12" cy="12" r="9" /><line x1="9" y1="9" x2="15" y2="15" /><line x1="15" y1="9" x2="9" y2="15" />',
  'chevron-down': '<polyline points="6 9 12 15 18 9" />',
  check: '<polyline points="4 12 9 17 20 6" />',
  'check-circle':
    '<circle cx="12" cy="12" r="9" /><polyline points="8 12 11 15 16 9" />',
  'alert-triangle':
    '<path d="M10.3 4.3 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 4.3a2 2 0 0 0-3.4 0Z" /><line x1="12" y1="10" x2="12" y2="13" /><line x1="12" y1="16" x2="12.01" y2="16" />',
  database:
    '<ellipse cx="12" cy="5" rx="8" ry="3" /><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5" /><path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6" />',
  lock: '<rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" />',
  zap: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />',
  github:
    '<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.9a3.4 3.4 0 0 0-.9-2.6c3-.3 6.1-1.5 6.1-6.6A5.1 5.1 0 0 0 18 4.8 4.7 4.7 0 0 0 17.9 1S16.7.7 14 2.5a12.3 12.3 0 0 0-6 0C5.3.7 4.1 1 4.1 1A4.7 4.7 0 0 0 4 4.8 5.1 5.1 0 0 0 2.6 8.9c0 5.1 3.1 6.3 6.1 6.6a3.4 3.4 0 0 0-.9 2.6V22" />',
  twitter:
    '<path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 12.4 2 .1 4-.6 6-2C3 14.5.5 9.6 3 5c2.2 2.6 5.6 4.2 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z" />',
  image:
    '<rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21" />',
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={ariaHidden}
  role={role}
  aria-label={label}
  set:html={paths[name]}
/>
