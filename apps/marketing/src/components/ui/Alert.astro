---
import Icon from './Icon.astro';

interface Props {
  variant?: 'success' | 'error';
  class?: string;
}

const { variant = 'success', class: className = '' } = Astro.props;

const styles = {
  success: 'border-status-success bg-status-success-bg text-status-success',
  error: 'border-status-error bg-status-error-bg text-status-error',
} as const;

const icons = {
  success: 'check-circle',
  error: 'alert-triangle',
} as const;
---

<div
  class:list={[
    'flex items-start gap-3 rounded-md border px-4 py-3 text-body-sm',
    styles[variant],
    className,
  ]}
  role="status"
>
  <Icon name={icons[variant]} size={20} class="mt-0.5 shrink-0" />
  <p class="m-0 leading-relaxed text-fg"><slot /></p>
</div>
