---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'destructive';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
  fullWidth?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  disabled = false,
  class: className = '',
  fullWidth = false,
} = Astro.props;

const sizes = {
  sm: 'px-4 py-2 text-body-sm',
  md: 'px-5 py-[11px] text-body-sm',
  lg: 'px-6 py-3.5 text-body-sm',
} as const;

const variants = {
  primary: 'bg-accent text-accent-on hover:bg-accent-hover focus-visible:outline-accent',
  secondary: 'bg-bg-muted text-fg hover:bg-bg-subtle focus-visible:outline-accent',
  outline:
    'border border-border bg-bg text-fg hover:border-border-strong hover:shadow-sm focus-visible:outline-accent',
  ghost: 'bg-transparent text-fg hover:bg-bg-muted focus-visible:outline-accent',
  destructive:
    'bg-status-error text-fg-inverse hover:opacity-90 focus-visible:outline-status-error',
} as const;

const disabledClasses =
  'pointer-events-none cursor-not-allowed bg-bg-muted text-fg-subtle border border-border hover:bg-bg-muted hover:shadow-none';

const classes = [
  'inline-flex items-center justify-center rounded-md font-semibold transition',
  'focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2',
  sizes[size],
  disabled ? disabledClasses : variants[variant],
  fullWidth ? 'w-full' : '',
  className,
]
  .filter(Boolean)
  .join(' ');
---

{
  href ? (
    <a class={classes} href={disabled ? undefined : href} aria-disabled={disabled || undefined}>
      <slot />
    </a>
  ) : (
    <button class={classes} type={type} disabled={disabled}>
      <slot />
    </button>
  )
}
