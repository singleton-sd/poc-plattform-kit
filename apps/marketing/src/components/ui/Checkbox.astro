---
interface Props {
  id: string;
  name?: string;
  label?: string;
  checked?: boolean;
  value?: string;
  required?: boolean;
  class?: string;
}

const {
  id,
  name = id,
  label,
  checked = false,
  value = 'on',
  required = false,
  class: className = '',
} = Astro.props;
---

<label
  class:list={['inline-flex cursor-pointer items-start gap-3 text-body-sm text-fg', className]}
  data-lead-field
>
  <input
    id={id}
    name={name}
    type="checkbox"
    value={value}
    checked={checked}
    required={required}
    aria-required={required || undefined}
    class="mt-0.5 size-4 shrink-0 rounded-sm border border-border accent-accent"
  />
  <span>
    <slot>{label}</slot>
    {
      required ? (
        <span class="text-accent" aria-hidden="true">
          {' '}
          *
        </span>
      ) : null
    }
  </span>
</label>
