---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  name: string;
  price: string;
  priceYearly?: string;
  periodLabel?: string;
  description: string;
  features: string[];
  cta: { label: string; href: string };
  highlighted?: boolean;
  ctaVariant?: 'primary' | 'outline' | 'ghost';
  class?: string;
}

const {
  name,
  price,
  priceYearly,
  periodLabel = '/mo',
  description,
  features,
  cta,
  highlighted = false,
  ctaVariant = highlighted ? 'primary' : 'outline',
  class: className = '',
} = Astro.props;

const showPeriod = Boolean(periodLabel) && price !== 'Custom';
---

<article
  class:list={[
    'flex h-full flex-col gap-8 rounded-xl border bg-bg p-8 shadow-sm',
    highlighted ? 'border-2 border-accent shadow-md' : 'border-border',
    className,
  ]}
>
  <div class="space-y-3">
    <div class="flex items-center justify-between gap-2">
      <p
        class:list={[
          'm-0 text-body-sm font-bold uppercase tracking-wide',
          highlighted ? 'text-accent' : 'text-fg-muted',
        ]}
      >
        {name}
      </p>
      {
        highlighted ? (
          <span class="rounded bg-accent-bg px-2 py-1 text-[10px] font-bold uppercase tracking-wide text-accent">
            Most popular
          </span>
        ) : null
      }
    </div>
    <p class="m-0 flex items-baseline gap-1 font-heading text-fg">
      <span
        class="text-[3.25rem] leading-none tracking-tight"
        data-price-monthly={price}
        data-price-yearly={priceYearly ?? price}
      >
        {price}
      </span>
      {
        showPeriod ? (
          <span class="text-lg font-normal text-fg-muted">{periodLabel}</span>
        ) : null
      }
    </p>
    <p class="m-0 text-body-sm leading-relaxed text-fg-muted">{description}</p>
  </div>

  <hr class="m-0 border-0 border-t border-border" />

  <ul class="m-0 flex flex-1 list-none flex-col gap-4 p-0">
    {
      features.map((feature, index) => (
        <li class="flex items-start gap-3 text-body-sm text-fg">
          <Icon name="check" size={16} class="mt-0.5 shrink-0 text-accent" />
          <span class:list={[highlighted && index === 0 ? 'font-semibold' : '']}>
            {feature}
          </span>
        </li>
      ))
    }
  </ul>

  <Button href={cta.href} variant={ctaVariant} fullWidth>
    {cta.label}
  </Button>
</article>
