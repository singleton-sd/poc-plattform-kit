---
import type { IconName } from '../../lib/icons';
import Icon from '../ui/Icon.astro';

interface Props {
  title: string;
  description: string;
  icon?: IconName;
  class?: string;
}

const { title, description, icon = 'zap', class: className = '' } = Astro.props;
---

<article
  class:list={[
    'flex flex-col gap-4 rounded-xl border border-border bg-bg p-6 md:p-8',
    className,
  ]}
>
  <div
    class="inline-flex size-10 items-center justify-center rounded-md bg-accent-bg text-accent"
    aria-hidden="true"
  >
    <Icon name={icon} size={20} />
  </div>
  <h3 class="m-0 font-heading text-h3 text-fg">{title}</h3>
  <p class="m-0 text-body-sm leading-relaxed text-fg-muted">{description}</p>
</article>
