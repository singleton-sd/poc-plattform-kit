---
import type { IconName } from '../../lib/icons';
import {
  CONTACT_LIMITS,
  CONTACT_MESSAGE_FIELD_MAX,
  CONTACT_SUBJECT_OPTIONS,
} from '../../lib/contact-form.mjs';
import Icon from '../ui/Icon.astro';
import TextInput from '../ui/TextInput.astro';
import Select from '../ui/Select.astro';
import TextArea from '../ui/TextArea.astro';
import Button from '../ui/Button.astro';
import Alert from '../ui/Alert.astro';
import PageContainer from '../shell/PageContainer.astro';

interface ReachItem {
  label: string;
  value: string;
  href: string;
  icon: IconName;
}

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const reachItems: ReachItem[] = [
  {
    label: 'Email Support',
    value: 'support@singletonsd.com',
    href: 'mailto:support@singletonsd.com',
    icon: 'mail',
  },
  {
    label: 'Main Website',
    value: 'singletonsd.com',
    href: 'https://singletonsd.com',
    icon: 'globe',
  },
  {
    label: 'GitHub Repository',
    value: 'github.com/singleton-sd/poc-plattform-kit',
    href: 'https://github.com/singleton-sd/poc-plattform-kit',
    icon: 'github',
  },
];
---

<section class:list={['pb-20 pt-4 md:pb-[7.5rem] md:pt-10', className]}>
  <PageContainer>
    <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_23.75rem] lg:gap-16">
      <div class="relative">
        <div id="contact-form-panel">
          <form id="contact-form" class="flex flex-col gap-8" novalidate>
            <div id="contact-form-error" class="hidden" role="alert">
              <Alert variant="error">
                <span id="contact-form-error-text"
                  >Please fix the highlighted fields and try again.</span
                >
              </Alert>
            </div>

            <div class="flex flex-col gap-6">
              <div class="grid gap-6 md:grid-cols-2">
                <TextInput
                  id="contact-name"
                  name="name"
                  label="First & Last Name"
                  placeholder="e.g. John Doe"
                  autocomplete="name"
                  maxlength={CONTACT_LIMITS.nameMax}
                  required
                />
                <TextInput
                  id="contact-email"
                  name="email"
                  type="email"
                  label="Email Address"
                  placeholder="you@company.com"
                  autocomplete="email"
                  maxlength={CONTACT_LIMITS.emailMax}
                  required
                />
              </div>
              <div class="grid gap-6 md:grid-cols-2">
                <TextInput
                  id="contact-company"
                  name="company"
                  label="Company"
                  placeholder="e.g. Singleton SD"
                  autocomplete="organization"
                  maxlength={CONTACT_LIMITS.companyMax}
                />
                <TextInput
                  id="contact-phone"
                  name="phone"
                  type="tel"
                  label="Phone"
                  placeholder="+61 400 000 000"
                  helper="Include a country code. Leave blank if you prefer email."
                  autocomplete="tel"
                  inputmode="tel"
                  maxlength={CONTACT_LIMITS.phoneMax}
                />
              </div>
              <Select
                id="contact-subject"
                name="subject"
                label="Inquiry type"
                placeholder="Select an option"
                helper="Optional. Sales and demo links preselect this for you."
                options={CONTACT_SUBJECT_OPTIONS}
              />
              <TextArea
                id="contact-message"
                name="message"
                label="Message"
                placeholder="How can we help you?"
                helper={`At least ${CONTACT_LIMITS.messageMin} characters.`}
                rows={5}
                minlength={CONTACT_LIMITS.messageMin}
                maxlength={CONTACT_MESSAGE_FIELD_MAX}
                showCount
                required
              />
            </div>

            <div class="flex flex-col gap-3">
              <Button type="submit" size="lg" class="w-full sm:w-[12.5rem]">
                Send message
              </Button>
              <p class="m-0 text-caption text-fg-muted">
                We typically respond within 24 hours.
              </p>
            </div>
          </form>
        </div>

        <div id="contact-success" class="hidden space-y-4" role="status">
          <Alert variant="success">
            Thanks — your message was sent. We typically respond within 24 hours.
          </Alert>
          <div id="contact-reset">
            <Button type="button" variant="outline" size="lg">
              Send another message
            </Button>
          </div>
        </div>
      </div>

      <aside
        class="flex flex-col gap-8 rounded-xl border border-border bg-bg-muted p-6 md:p-10"
      >
        <div class="space-y-2">
          <h2 class="m-0 font-heading text-h3 text-fg">Other ways to reach us</h2>
          <p class="m-0 text-body-sm leading-relaxed text-fg-muted">
            Need specialized assistance? You can directly contact our teams or browse
            open code.
          </p>
        </div>
        <hr class="m-0 border-0 border-t border-border" />
        <ul class="m-0 flex list-none flex-col gap-5 p-0">
          {
            reachItems.map((item) => (
              <li class="flex items-center gap-3">
                <span class="inline-flex size-5 shrink-0 text-accent" aria-hidden="true">
                  <Icon name={item.icon} size={20} />
                </span>
                <div class="min-w-0">
                  <p class="m-0 text-[12px] font-bold uppercase tracking-wide text-fg-muted">
                    {item.label}
                  </p>
                  <a
                    href={item.href}
                    class="text-body-sm font-semibold text-fg transition hover:text-accent"
                    rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                    target={item.href.startsWith('http') ? '_blank' : undefined}
                  >
                    {item.value}
                  </a>
                </div>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </PageContainer>
</section>

<script>
  import {
    buildPostKitContactPayload,
    isContactFormValid,
    resolveInquirySubject,
    validateContactForm,
  } from '../../lib/contact-form.mjs';

  type ContactFormFields = {
    name: string;
    email: string;
    company: string;
    phone: string;
    subject: string;
    message: string;
  };

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const formPanel = document.getElementById('contact-form-panel');
  const successPanel = document.getElementById('contact-success');
  const formError = document.getElementById('contact-form-error');
  const formErrorText = document.getElementById('contact-form-error-text');
  const resetButton = document.getElementById('contact-reset')?.querySelector('button');
  const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
  const submitIdleLabel = submitButton?.textContent?.trim() || 'Send message';
  const fieldIds = [
    'contact-name',
    'contact-email',
    'contact-company',
    'contact-phone',
    'contact-subject',
    'contact-message',
  ] as const;
  let attemptedSubmit = false;
  const apiBase = (
    (import.meta.env.PUBLIC_POSTKIT_API_BASE_URL as string | undefined) ||
    'https://ssd-postkit-api-prod-ae.azurewebsites.net'
  ).replace(/\/$/, '');

  function readFields(): ContactFormFields {
    if (!form) {
      return { name: '', email: '', company: '', phone: '', subject: '', message: '' };
    }
    return {
      name: (form.elements.namedItem('name') as HTMLInputElement).value,
      email: (form.elements.namedItem('email') as HTMLInputElement).value,
      company: (form.elements.namedItem('company') as HTMLInputElement).value,
      phone: (form.elements.namedItem('phone') as HTMLInputElement).value,
      subject: (form.elements.namedItem('subject') as HTMLSelectElement).value,
      message: (form.elements.namedItem('message') as HTMLTextAreaElement).value,
    };
  }

  function fieldDescribedBy(id: string, hasError: boolean): string | undefined {
    const ids = [
      hasError ? `${id}-error` : null,
      document.getElementById(`${id}-helper`) ? `${id}-helper` : null,
      document.getElementById(`${id}-count`) ? `${id}-count` : null,
    ].filter(Boolean);
    return ids.length ? ids.join(' ') : undefined;
  }

  function setFieldError(id: string, message: string | null) {
    const field = document.getElementById(id) as
      | HTMLInputElement
      | HTMLSelectElement
      | HTMLTextAreaElement
      | null;
    if (!field) return;

    const wrapper = field.closest('div.flex.w-full.flex-col') ?? field.parentElement;
    const existing = document.getElementById(`${id}-error`);
    if (existing) existing.remove();

    field.removeAttribute('aria-invalid');
    const describedBy = fieldDescribedBy(id, Boolean(message));
    if (describedBy) field.setAttribute('aria-describedby', describedBy);
    else field.removeAttribute('aria-describedby');
    const borderHost = field.tagName === 'INPUT' ? field.parentElement : field;
    borderHost?.classList.remove('border-status-error');

    if (!message || !wrapper) return;

    const errorId = `${id}-error`;
    field.setAttribute('aria-invalid', 'true');
    field.setAttribute('aria-describedby', fieldDescribedBy(id, true) ?? errorId);
    borderHost?.classList.add('border-status-error');
    const error = document.createElement('p');
    error.id = errorId;
    error.className = 'm-0 text-caption text-status-error';
    error.textContent = message;
    const count = document.getElementById(`${id}-count`);
    if (count) wrapper.insertBefore(error, count);
    else wrapper.appendChild(error);
  }

  function applyFieldErrors(errors: ReturnType<typeof validateContactForm>) {
    setFieldError('contact-name', errors.name ?? null);
    setFieldError('contact-email', errors.email ?? null);
    setFieldError('contact-company', errors.company ?? null);
    setFieldError('contact-phone', errors.phone ?? null);
    setFieldError('contact-subject', errors.subject ?? null);
    setFieldError('contact-message', errors.message ?? null);
  }

  function updateMessageCount() {
    const field = document.getElementById('contact-message') as HTMLTextAreaElement | null;
    const count = document.getElementById('contact-message-count');
    const max = field?.getAttribute('maxlength');
    if (!field || !count || !max) return;
    count.textContent = `${field.value.length}/${max}`;
  }

  function validateAndPaint(): boolean {
    const errors = validateContactForm(readFields());
    applyFieldErrors(errors);
    return isContactFormValid(errors);
  }

  function revalidateIfNeeded() {
    updateMessageCount();
    if (!attemptedSubmit) return;
    const ok = validateAndPaint();
    formError?.classList.toggle('hidden', ok);
    if (ok && formErrorText) {
      formErrorText.textContent = 'Please fix the highlighted fields and try again.';
    }
  }

  function showFormError(message: string) {
    if (formErrorText) formErrorText.textContent = message;
    formError?.classList.remove('hidden');
  }

  function setSubmitPending(pending: boolean) {
    if (!submitButton) return;
    submitButton.disabled = pending;
    submitButton.setAttribute('aria-busy', pending ? 'true' : 'false');
    submitButton.textContent = pending ? 'Sending…' : submitIdleLabel;
  }

  function applyInquiryTypeFromCta() {
    const params = new URLSearchParams(window.location.search);
    const fromQuery = resolveInquirySubject(params.get('subject') ?? params.get('inquiry'));
    if (!fromQuery) return;
    const select = document.getElementById('contact-subject') as HTMLSelectElement | null;
    if (select) select.value = fromQuery;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    attemptedSubmit = true;
    const ok = validateAndPaint();
    formError?.classList.toggle('hidden', ok);
    if (!ok) {
      if (formErrorText) {
        formErrorText.textContent = 'Please fix the highlighted fields and try again.';
      }
      return;
    }

    const payload = buildPostKitContactPayload(readFields());
    if (!payload.ok) {
      applyFieldErrors(payload.errors);
      showFormError('Please fix the highlighted fields and try again.');
      return;
    }

    setSubmitPending(true);
    try {
      const isPreview =
        location.pathname.includes('/pr-preview/') ||
        location.hostname.endsWith('.azurestaticapps.net') ||
        location.hostname === 'localhost';
      const response = await fetch(`${apiBase}/contact`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
          ...(isPreview ? { 'X-PostKit-Contact-Preview': 'true' } : {}),
        },
        credentials: 'omit',
        body: JSON.stringify(payload.value),
      });

      if (!response.ok) {
        let detail = 'We could not send your message. Please try again shortly.';
        if (response.status === 400) {
          detail = 'Please fix the highlighted fields and try again.';
        } else if (response.status === 429) {
          detail = 'Too many messages were sent. Please wait a minute and try again.';
        } else if (response.status >= 500) {
          detail = 'Delivery is temporarily unavailable. Please try again later.';
        }
        showFormError(detail);
        return;
      }

      formPanel?.classList.add('hidden');
      successPanel?.classList.remove('hidden');
      formError?.classList.add('hidden');
    } catch {
      showFormError('We could not reach the server. Check your connection and try again.');
    } finally {
      setSubmitPending(false);
    }
  });

  for (const id of fieldIds) {
    const field = document.getElementById(id);
    field?.addEventListener('blur', revalidateIfNeeded);
    field?.addEventListener('input', revalidateIfNeeded);
    field?.addEventListener('change', revalidateIfNeeded);
  }

  resetButton?.addEventListener('click', () => {
    attemptedSubmit = false;
    form?.reset();
    applyInquiryTypeFromCta();
    fieldIds.forEach((id) => setFieldError(id, null));
    updateMessageCount();
    formError?.classList.add('hidden');
    if (formErrorText) {
      formErrorText.textContent = 'Please fix the highlighted fields and try again.';
    }
    successPanel?.classList.add('hidden');
    formPanel?.classList.remove('hidden');
  });

  applyInquiryTypeFromCta();
  updateMessageCount();
</script>
