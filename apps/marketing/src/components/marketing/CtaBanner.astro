---
import Button from '../ui/Button.astro';
import PageContainer from '../shell/PageContainer.astro';

interface Props {
  title: string;
  description?: string;
  cta: { label: string; href: string };
  class?: string;
}

const { title, description, cta, class: className = '' } = Astro.props;
---

<section class:list={['py-12 md:py-16', className]}>
  <PageContainer>
    <div
      class="flex flex-col items-start justify-between gap-6 rounded-2xl bg-bg-inverse px-6 py-8 text-fg-inverse md:flex-row md:items-center md:gap-10 md:px-16 md:py-16"
    >
      <div class="max-w-2xl space-y-3">
        <h2 class="m-0 font-heading text-h3 md:text-h2">{title}</h2>
        {
          description ? (
            <p class="m-0 text-body-sm leading-relaxed text-fg-subtle">{description}</p>
          ) : null
        }
      </div>
      <Button href={cta.href} size="lg" class="shrink-0">
        {cta.label}
      </Button>
    </div>
  </PageContainer>
</section>
