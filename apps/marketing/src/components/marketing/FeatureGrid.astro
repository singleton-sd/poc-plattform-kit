---
import type { FeatureItem } from '../../lib/marketing-types';
import FeatureCard from './FeatureCard.astro';
import PageContainer from '../shell/PageContainer.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  features: FeatureItem[];
  align?: 'start' | 'center';
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  features,
  align = 'start',
  class: className = '',
} = Astro.props;

const headerAlign = align === 'center' ? 'mx-auto text-center' : '';
---

<section class:list={['py-16 md:py-20', className]}>
  <PageContainer>
    {
      eyebrow || title || description ? (
        <div class:list={['mb-12 max-w-3xl', headerAlign]}>
          {eyebrow ? (
            <p class="m-0 mb-3 text-body-sm font-bold uppercase tracking-wide text-accent">
              {eyebrow}
            </p>
          ) : null}
          {title ? <h2 class="m-0 font-heading text-h2 text-fg">{title}</h2> : null}
          {description ? (
            <p class="mt-3 m-0 text-base leading-relaxed text-fg-muted">{description}</p>
          ) : null}
        </div>
      ) : null
    }
    <div class="grid gap-6 md:grid-cols-3">
      {
        features.map((feature) => (
          <FeatureCard
            title={feature.title}
            description={feature.description}
            icon={feature.icon}
          />
        ))
      }
    </div>
  </PageContainer>
</section>
