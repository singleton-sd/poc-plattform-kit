---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/marketing/Hero.astro';
import { getEntry } from 'astro:content';
import { appCta } from '../lib/nav';

const home = await getEntry('pages', 'home');
if (!home) {
  throw new Error('Missing content: pages/home');
}
const { Content } = await home.render();
const { title, description, brand, headline, ctaLabel, ctaUrl } = home.data;
---

<BaseLayout title={title} description={description}>
  <Hero
    eyebrow={brand ?? 'Platform Kit'}
    headline={headline ?? 'Multi-tenant infrastructure, ready to ship.'}
    primaryCta={{
      label: ctaLabel ?? appCta.label,
      href: ctaUrl ?? appCta.href,
    }}
  >
    <div class="[&_p]:m-0">
      <Content />
    </div>
  </Hero>
</BaseLayout>
