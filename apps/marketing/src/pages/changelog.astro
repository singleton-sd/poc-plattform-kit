---
import changelog from '../data/changelog.json';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="What’s new | Platform Kit" description="Recent Platform Kit website updates.">
  <main class="mx-auto max-w-3xl px-6 py-16">
    <a class="text-sm text-accent hover:underline" href="/">← Back to Platform Kit</a>
    <p class="mt-10 text-sm font-semibold uppercase tracking-[0.2em] text-accent">Product updates</p>
    <h1 class="mt-3 font-heading text-4xl font-bold tracking-tight">What’s new</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-fg-muted">
      The latest website improvements, generated from the commits that created each release.
    </p>

    <div class="mt-12 space-y-12">
      {
        changelog.releases.map((release) => (
          <article class="border-l-2 border-accent pl-6">
            <header class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h2 class="font-heading text-2xl font-semibold">Version {release.version}</h2>
              <time class="text-sm text-fg-muted" datetime={release.date}>
                {new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(
                  new Date(`${release.date}T00:00:00Z`),
                )}
              </time>
            </header>
            <ul class="mt-5 space-y-5">
              {
                release.changes.length === 0 ? (
                  <li class="text-fg-muted">No client-facing changes were recorded for this release.</li>
                ) : null
              }
              {release.changes.map((change) => (
                <li>
                  <p>
                    <span class="mr-2 rounded bg-accent-bg px-2 py-1 text-xs font-semibold text-accent">
                      {change.type}
                    </span>
                    <span class="font-medium">{change.summary}</span>
                  </p>
                  {'reason' in change ? (
                    <p class="mt-2 leading-relaxed text-fg-muted">{change.reason}</p>
                  ) : null}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </main>
</BaseLayout>
