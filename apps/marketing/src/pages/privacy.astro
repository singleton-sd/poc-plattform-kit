---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'privacy');
if (!page) {
  throw new Error('Missing content: pages/privacy');
}
const { Content } = await page.render();
const { title, description, updated } = page.data;
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-2xl px-6 pb-16 pt-[clamp(2rem,8vh,4rem)]">
    <a
      class="mb-6 inline-block text-fg-muted hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      href="/"
    >
      ← Back to Platform Kit
    </a>
    <article class="prose-legal">
      <h1 class="mb-1 font-heading text-3xl font-bold tracking-tight text-fg">{title}</h1>
      {updated ? <p class="mb-8 text-sm text-fg-muted">Last updated: {updated}</p> : null}
      <Content />
    </article>
  </div>
</BaseLayout>
