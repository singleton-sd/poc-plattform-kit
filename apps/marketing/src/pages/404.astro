---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import PageContainer from '../components/shell/PageContainer.astro';
---

<BaseLayout title="Page not found — Platform Kit" description="This page does not exist.">
  <PageContainer narrow class="pb-12 pt-[clamp(3rem,12vh,6rem)] text-center">
    <p class="mb-3 font-heading text-body-sm font-semibold uppercase tracking-widest text-accent">
      404
    </p>
    <h1 class="mb-3 font-heading text-h1 text-fg">Page not found</h1>
    <p class="mb-8 text-base leading-relaxed text-fg-muted">
      That URL is not on this site. It may have been moved, renamed, or never published.
    </p>
    <Button href="/" size="lg">Back to Platform Kit</Button>
  </PageContainer>
</BaseLayout>
