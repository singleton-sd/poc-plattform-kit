---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageContainer from '../components/shell/PageContainer.astro';
import LegalContactBanner from '../components/marketing/LegalContactBanner.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages
    .filter((entry) => entry.slug !== 'home')
    .map((entry) => ({
      params: { slug: entry.slug },
      props: { page: entry },
    }));
}

interface Props {
  page: CollectionEntry<'pages'>;
}

const { page } = Astro.props;
const { Content } = await page.render();
const { title, description, updated } = page.data;

const contactTitle =
  page.slug === 'terms' ? 'Questions about these terms?' : 'Questions about this policy?';
---

<BaseLayout title={title} description={description}>
  <header class="bg-bg-hero">
    <PageContainer class="flex flex-col items-start gap-3 px-5 pb-10 pt-12 md:items-center md:pb-16 md:pt-20 md:text-center">
      <p class="m-0 text-body-sm font-bold uppercase tracking-wide text-accent">
        Legal &amp; Compliance
      </p>
      <h1 class="m-0 font-heading text-h1 text-fg md:text-[3rem] md:leading-tight">
        {title}
      </h1>
      {
        updated ? (
          <p class="m-0 text-body-sm text-fg-subtle">Last updated: {updated}</p>
        ) : null
      }
    </PageContainer>
  </header>

  <PageContainer narrow class="pb-16 md:pb-[6.25rem]">
    <article class="prose-legal">
      <Content />
    </article>
    <LegalContactBanner title={contactTitle} />
  </PageContainer>
</BaseLayout>
