{
  "name": "@poc-plattform-kit/pillar-single-sign-on",
  "version": "0.4.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @poc-plattform-kit/db run build",
    "build": "tsc -p tsconfig.json",
    "lint": "echo \"lint:pillar-single-sign-on stub\"",
    "pretest": "pnpm --filter @poc-plattform-kit/db run build",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@poc-plattform-kit/db": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.9",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@poc-plattform-kit/db$": "<rootDir>/../../../packages/db/src/index.ts"
    },
    "testEnvironment": "node"
  }
}
