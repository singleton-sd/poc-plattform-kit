{
  "name": "@poc-plattform-kit/pillar-contact",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prebuild": "pnpm --filter @poc-plattform-kit/events run build",
    "build": "tsc -p tsconfig.json",
    "lint": "echo \"lint:contact stub\"",
    "pretest": "pnpm --filter @poc-plattform-kit/events run build",
    "test": "jest"
  },
  "dependencies": {
    "@poc-plattform-kit/events": "workspace:*"
  },
  "devDependencies": {
    "@poc-plattform-kit/pillar-audit": "workspace:*",
    "@poc-plattform-kit/pillar-reporting": "workspace:*",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@poc-plattform-kit/events$": "<rootDir>/../../../packages/events/src/index.ts",
      "^@poc-plattform-kit/pillar-audit$": "<rootDir>/../../audit/src/index.ts",
      "^@poc-plattform-kit/pillar-reporting$": "<rootDir>/../../reporting/src/index.ts"
    }
  }
}
